# MapTiler API key for the base map tiles (https://cloud.maptiler.com/account/keys/).
# Read server-side and passed to the map as a prop (no NEXT_PUBLIC_ prefix).
# The key is visible in browser tile requests, so protect it with MapTiler
# "Allowed origins" (e.g. https://nbim-map.vercel.app and http://localhost:3000
# for local dev).
#
# OPTIONAL. The basemap is a chain of interchangeable providers, all rendered by
# the same MapLibre engine: MapTiler -> OpenFreeMap (keyless vector tiles) ->
# OpenStreetMap raster tiles. Leave this blank — or let the credits run out, in
# which case MapTiler answers 401/402/403/429 — and the map switches itself to
# the next tier instead of disappearing.
MAPTILER_API_KEY=

# Pins the top of that basemap chain. `auto` (default) leads with MapTiler when
# a key is set; `openfreemap` or `osm` skip straight to a keyless tier — the
# one-line switch to flip while MapTiler credits are exhausted. Lower tiers stay
# available as backups either way.
# auto | maptiler | openfreemap | osm
# Read at build time (the homepage is prerendered), so changing it needs a
# redeploy — same as MAPTILER_API_KEY.
MAP_PROVIDER=auto

# Google Maps API key (required for Street View embeds in production)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Maps API key for local development Street View (optional — Street View disabled if unset)
SECRET_DEV_GOOGLE_MAPS_API_KEY=

# ATTOM API key — only needed to regenerate data/attom-data.json via `npm run fetch:attom`
# Not required for running the app itself
ATTOM_API_KEY=
